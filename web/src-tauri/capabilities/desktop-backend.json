{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-backend",
  "description": "Tray controls for the desktop loopback backend",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "tray-controls"
  ]
}
